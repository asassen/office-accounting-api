<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:client="clr-namespace:OfficeAccounting.Client;assembly=OfficeAccounting.Client"
             x:Class="OfficeAccountingMaui.InvoicesPage"
             Title="Invoices">

    <Grid RowDefinitions="Auto,*" Padding="16" RowSpacing="10">
        <Label x:Name="StatusLabel" TextColor="Gray" />

        <RefreshView x:Name="Refresher" Grid.Row="1" Refreshing="OnRefreshing">
            <CollectionView x:Name="InvoiceList" SelectionMode="Single"
                            SelectionChanged="OnInvoiceSelected">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="client:InvoiceSummary">
                        <Grid ColumnDefinitions="*,Auto" Padding="4,8">
                            <VerticalStackLayout>
                                <Label FontAttributes="Bold">
                                    <Label.FormattedText>
                                        <FormattedString>
                                            <Span Text="{Binding DocumentDisplayNumber}" />
                                            <Span Text="  " />
                                            <Span Text="{Binding CustomerName}" FontAttributes="None" />
                                        </FormattedString>
                                    </Label.FormattedText>
                                </Label>
                                <Label Text="{Binding FinancialDateTime, StringFormat='{0:dd MMM yyyy}'}"
                                       TextColor="Gray" FontSize="12" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="1" HorizontalOptions="End">
                                <Label Text="{Binding TotalPrice, StringFormat='{0:N2}'}" HorizontalOptions="End" />
                                <Label Text="{Binding Balance, StringFormat='Due {0:N2}'}"
                                       TextColor="Gray" FontSize="12" HorizontalOptions="End" />
                            </VerticalStackLayout>
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>
    </Grid>
</ContentPage>
