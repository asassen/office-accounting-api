<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="OfficeAccountingMaui.SettingsPage"
             Title="Settings">

    <VerticalStackLayout Padding="16" Spacing="10">
        <Entry x:Name="UrlEntry" Placeholder="Service URL, e.g. http://ants-pc:5080/" Keyboard="Url" />
        <Entry x:Name="KeyEntry" Placeholder="API key" IsPassword="True" />
        <Button Text="Save" Clicked="OnSaveClicked" />
        <Label x:Name="StatusLabel" TextColor="Gray" />
    </VerticalStackLayout>
</ContentPage>
