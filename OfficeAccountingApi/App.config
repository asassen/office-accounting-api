<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
  </startup>
  <appSettings>
    <!-- Company file to open. A bare file name is resolved under Documents\Small Business Accounting\Companies -->
    <add key="CompanyFile" value="SampleProductCompany2009.sbc" />
    <!-- If both are set they override CompanyFile (the .sbc server name is stale after a PC rename). -->
    <add key="Database" value="SampleProductCompany2009" />
    <add key="Server" value=".\MSSMLBIZ" />
    <!-- Change this before use. Clients send it in the X-Api-Key header. -->
    <add key="ApiKey" value="CHANGE-ME" />
    <!-- Listen address. http://+:5080/ accepts any host name (needed for Tailscale); restrict access with the firewall rule in the README. Use http://localhost:5080/ for local-only. -->
    <add key="Prefix" value="http://+:5080/" />
  </appSettings>
</configuration>




