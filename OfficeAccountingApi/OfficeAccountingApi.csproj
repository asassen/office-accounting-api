<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <PlatformTarget>x86</PlatformTarget>
    <Prefer32Bit>true</Prefer32Bit>
    <LangVersion>9.0</LangVersion>
    <RootNamespace>OfficeAccountingApi</RootNamespace>
    <AssemblyName>OfficeAccountingApi</AssemblyName>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
  </PropertyGroup>

  <PropertyGroup>
    <OaDir>C:\Program Files (x86)\Microsoft Small Business\Office Accounting 2009\</OaDir>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <Reference Include="System.Web.Extensions" />
    <Reference Include="System.Configuration" />
    <Reference Include="System.ServiceProcess" />
  </ItemGroup>

  <!-- Compile-time only: the real assemblies are resolved from the Office Accounting install at runtime. -->
  <ItemGroup>
    <Reference Include="SBAIAPI"><HintPath>$(OaDir)Assemblies\SBAIAPI.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="SBAIAPIV2"><HintPath>$(OaDir)Assemblies\SBAIAPIV2.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="SBAIAPIV3"><HintPath>$(OaDir)Assemblies\SBAIAPIV3.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="SBAIAPIV4"><HintPath>$(OaDir)Assemblies\SBAIAPIV4.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="SBAIAPIEnGB"><HintPath>$(OaDir)SBAIAPIEnGB.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="ILoader"><HintPath>$(OaDir)..\Small Business Loader\ILoader.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>

</Project>
